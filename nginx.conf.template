events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Carry the WebSocket upgrade through the Flows live-update proxy below.
    # A literal `Connection: upgrade` would break any plain HTTP request that
    # reached the same location, so the value follows what the client asked
    # for and stays empty when it asked for nothing.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 80;
        server_name localhost;
        root /usr/share/nginx/html;
        index index.html;

        # CRITICAL: Force browser to treat this as secure context
        add_header Content-Security-Policy "upgrade-insecure-requests" always;
        
        # Tell browser this is a secure context (for localhost)
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        
        # Additional security headers
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-XSS-Protection "1; mode=block" always;
        
        # Critical for Web Crypto API
        add_header Permissions-Policy "crypto=*" always;

        location = /app {
            return 302 /app/;
        }

        # Reverse-proxy the Flows data API through our own origin. The SDK is
        # configured with init({ apiUrl: <our origin> }) and requests fixed paths
        # under /v2/sdk/*, so we proxy exactly those to api.flows-cloud.com over
        # TLS. Keeping the requests first-party stops Brave Shields / Firefox ETP
        # from blocking them as a third-party tracker (which otherwise left a blur
        # overlay with no content). Mounted at both / and /app for the optional
        # context path. Must precede the generic SPA/static locations below.
        location ~* ^/(app/)?(v2/sdk/.*)$ {
            resolver 1.1.1.1 8.8.8.8 valid=300s;
            set $flows_upstream "https://api.flows-cloud.com/$2$is_args$args";

            proxy_pass $flows_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host api.flows-cloud.com;
            proxy_ssl_server_name on;
            proxy_ssl_name api.flows-cloud.com;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass_request_headers on;
        }

        # Flows live block updates. The SDK derives this from the same apiUrl
        # as the REST calls, swapping the scheme for wss://, so it arrives here
        # first-party and needs proxying on exactly like /v2/sdk/* above —
        # matched at both / and /app for the optional context path.
        #
        # Without this location the request fell through to the SPA fallback,
        # which answered 200 with index.html instead of a 101 upgrade. The SDK
        # read that as a failed handshake and reconnected in a loop, filling
        # the console with WebSocket errors. Tours themselves never depended on
        # it — they render off the /v2/sdk/blocks response — but the retry
        # noise buried every other console message.
        location ~* ^/(app/)?(ws/sdk/.*)$ {
            resolver 1.1.1.1 8.8.8.8 valid=300s;
            set $flows_ws_upstream "https://api.flows-cloud.com/$2$is_args$args";

            proxy_pass $flows_ws_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host api.flows-cloud.com;
            proxy_ssl_server_name on;
            proxy_ssl_name api.flows-cloud.com;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Live updates idle for long stretches; the default 60s read
            # timeout would drop the socket and restart the retry loop this
            # location exists to stop.
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        location = /runtime-config.js {
            try_files /runtime-config.js =404;

            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma "no-cache";
            add_header Expires "0";
        }

        location = /app/runtime-config.js {
            try_files /runtime-config.js =404;

            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma "no-cache";
            add_header Expires "0";
        }

        # Serve ES module worker chunks with a JavaScript MIME type from both / and /app.
        location ~* ^/(app/)?[^?]*\.mjs$ {
            rewrite ^/app(/.*)$ $1 break;
            default_type application/javascript;
            try_files $uri =404;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        # Serve JS, font, image, JSON, and manifest files from both / and /app.
        location ~* ^/(app/)?[^?]*\.(js|css|png|jpg|woff|jpeg|gif|ico|svg|woff2|ttf|eot|json|webmanifest|txt)$ {
            rewrite ^/app(/.*)$ $1 break;

            try_files $uri =404;
            expires 1y;
            add_header Cache-Control "public, immutable";

            # CORS headers for fonts (required by browsers)
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Range" always;
        }

        location /app/ {
            rewrite ^/app(/.*)$ $1 break;
            try_files $uri $uri/ /index.html;

            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma "no-cache";
            add_header Expires "0";
        }

        # Handle Vue Router history mode - serve index.html for all non-file routes
        location / {
            try_files $uri $uri/ /index.html;
            
            # Prevent caching of index.html
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma "no-cache";
            add_header Expires "0";
        }

        # Enable gzip compression
        gzip on;
        gzip_vary on;
        gzip_min_length 1024;
        gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript;
    }
}
